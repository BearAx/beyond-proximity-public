{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent_query_trace.schema.json",
  "title": "Agent query trace",
  "type": "object",
  "required": [
    "schema_version",
    "method_protocol_id",
    "trace_id",
    "scene_id",
    "query",
    "client_name",
    "model_name",
    "status",
    "created_at",
    "steps",
    "accounting"
  ],
  "properties": {
    "schema_version": {
      "const": "semanticsplat.agent_query_trace.v1"
    },
    "method_protocol_id": {
      "const": "mcp_hierarchical_semantic_traversal.v1"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "client_name": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "phase",
          "tool_name",
          "request",
          "response",
          "created_at"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "object"
          },
          "response": {
            "type": "object"
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "token_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounting": {
      "type": "object",
      "required": [
        "step_count",
        "model_or_agent_call_count",
        "input_tokens",
        "output_tokens",
        "measured_input_step_count",
        "measured_output_step_count",
        "latency_ms"
      ],
      "properties": {
        "step_count": {
          "type": "integer",
          "minimum": 0
        },
        "model_or_agent_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "measured_input_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "measured_output_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
